// === THEME AND UI ===
theme "catppuccin-mocha"

// === KEYBINDINGS ===
keybinds {
    shared_except "locked" {
        // zellij-forgot (keybind cheat sheet / notes)
        bind "Ctrl Shift f" {
            LaunchOrFocusPlugin "zellij-forgot" {
                floating true
                move_to_focused_tab true
                "LOAD_ZELLIJ_BINDINGS" "true"
            }
        }
        // session-manager (active sessions / create sessions)
        bind "Ctrl Shift s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        // zsm (zoxide project sessions)
        bind "Ctrl Shift p" {
            LaunchOrFocusPlugin "zsm" {
                floating true
                move_to_focused_tab true
                default_layout "tabs"
                show_resurrectable_sessions true
                base_paths "/home/johannes/Repos|/home/johannes"
            }
            SwitchToMode "normal"
        }
        // Scratchpad floating pane
        bind "Alt t" { ToggleFloatingPanes; }

        // Vim Navigation
        bind "Ctrl h" {
            MessagePlugin "navigator" {
                name "move_focus_or_tab";
                payload "left";
                move_mod "ctrl";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "navigator" {
                name "move_focus_or_tab";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "navigator" {
                name "move_focus_or_tab";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "navigator" {
                name "move_focus_or_tab";
                payload "right";
                move_mod "ctrl";
            };
        }

        // Floating Apps
        bind "Alt g" {
            Run "bash" {
                args "-lc" "if command -v lazygit >/dev/null 2>&1; then exec lazygit; else printf 'Missing tool: lazygit\nInstall lazygit, then retry.\n\nPress Enter to close...'; read -r _; fi"
                floating true
                close_on_exit true
            };
        }
        bind "Alt m" {
            Run "bash" {
                args "-lc" "if command -v btop >/dev/null 2>&1; then exec btop; else printf 'Missing tool: btop\nInstall btop, then retry.\n\nPress Enter to close...'; read -r _; fi"
                floating true
                close_on_exit true
            };
        }
        bind "Alt y" {
            Run "bash" {
                args "-lc" "if command -v yazi >/dev/null 2>&1; then exec yazi; else printf 'Missing tool: yazi\nInstall yazi, then retry.\n\nPress Enter to close...'; read -r _; fi"
                floating true
                close_on_exit true
            };
        }

        // Tab Management
        bind "Alt H" { MoveTab "Left"; }
        bind "Alt L" { MoveTab "Right"; }

        // Additional enhancements
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleTab; }

        // Fast Tab Renaming
        bind "Alt r" {
            SwitchToMode "RenameTab";
            TabNameInput 0;
        }
    }
}

// === COPY/PASTE BEHAVIOR ===
copy_on_select true

// === SESSION BEHAVIOR ===
show_startup_tips false
session_serialization true
pane_viewport_serialization true
pane_frames false

plugins {
    session-manager location="zellij:session-manager"

    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.22.0/zjstatus.wasm"
    zellij-forgot location="https://github.com/karimould/zellij-forgot/releases/download/0.4.2/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "true"
    }

    navigator location="https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm"
    zsm location="https://github.com/liam-mackie/zsm/releases/download/v0.4.1/zsm.wasm"
}

// === LAYOUT SETTINGS ===
default_layout "tabs"

// === EDITOR INTEGRATION ===
scrollback_editor "nvim +$"
