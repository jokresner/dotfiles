// layouts/typst-dev.kdl
layout {
    pane split_direction="vertical" {
        // Left side: Editor for .typ files
        pane size="60%" {
            command "nvim"
            args "."
        }
        // Right side: Split horizontally
        pane split_direction="horizontal" {
            // Top right: Typst Compiler
            pane {
                name "typst-compiler"
                command "bash"
                args "-c" "clear; echo 'Ready to compile Typst (e.g., typst compile main.typ)'"
            }
            // Bottom right: General Commands
            pane {
                name "typst-commands"
                command "bash"
            }
        }
    }
}