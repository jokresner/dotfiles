// layouts/php-dev.kdl
layout {
    pane split_direction="vertical" {
        // Left side: Editor
        pane size="60%" {
            command "nvim"
            args "."
        }
        // Right side: Split horizontally
        pane split_direction="horizontal" {
            // Top right: PHP CLI / Runner
            pane {
                name "php-cli"
                command "bash"
                args "-c" "clear; echo 'Ready for PHP commands (e.g., composer install, php artisan serve)'"
            }
            // Bottom right: General Commands
            pane {
                name "php-commands"
                command "bash"
            }
        }
    }
}