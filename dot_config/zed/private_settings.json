// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": ""
      }
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "status_bar": {
    "show_active_file": true
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
    "enable_preview_multibuffer_from_code_navigation": true
  },
  "proxy": "",
  "edit_predictions": {
    "ollama": {
      "prompt_format": "qwen",
      "model": "qwen3.5:9b"
    },
    "provider": "zed"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "full",
  "indent_guides": {
    "background_coloring": "indent_aware"
  },
  "soft_wrap": "prefer_line",
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  "base_keymap": "None",
  "ui_font_family": "Rubik",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "redact_private_values": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
}
