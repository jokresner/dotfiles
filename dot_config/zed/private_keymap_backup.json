[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "space w": "workspace::Save",
      "space y": "editor::Copy",
      "space p": "editor::Paste",
      "s t": "workspace::NewTerminal",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDefinition",
      "g R": "editor::FindAllReferences",
      "g I": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "shift-k": "editor::Hover",
      "space c R": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
      "space space": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space /": "project_search::Toggle",
      "space f f": "file_finder::Toggle",
      "space f g": "file_finder::Toggle",
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      "space k": "pane::CloseActiveItem",
      "space shift-k": "pane::CloseActiveItem",
      "space g n": "workspace::ToggleRightDock",
      "[ h": "editor::GoToPrevHunk",
      "] h": "editor::GoToNextHunk",
      "-": "project_panel::ToggleFocus",
      "ctrl-/": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "<": "editor::Outdent",
      ">": "editor::Indent",
      "space y": "editor::Copy",
      "space p": "editor::Paste",
      "space l f": "editor::Format"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-/": "workspace::ToggleBottomDock"
    }
  }
]