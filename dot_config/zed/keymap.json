[
  {
    "context": "EmptyPane || SharedScreen || Dock",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f p": [
        "projects::OpenRecent",
        {
          "create_new_window": false
        }
      ],
      "space s g": "workspace::NewSearch",
      "space s k": "zed::OpenKeymap",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space g b": "git::Branch",
      "space g s": "git_panel::ToggleFocus",
      "space g d": "git::Diff",
      "space g O": "git::OpenModifiedFiles",
      "space x x": "diagnostics::Deploy",
      "space x X": "diagnostics::DeployCurrentFile",
      "space x w": "zed::OpenTasks",
      "space x o": "task::Spawn",
      "space t l": "task::Rerun",
      "ctrl-.": "assistant::Assist",
      "space a a": "assistant::Assist",
      "space d r": "debugger::FocusConsole",
      "space d u": "debugger::OpenProjectDebugTasks"
    }
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd",
      "left": "vim::WrappingLeft",
      "right": "vim::WrappingRight",
      "h": "vim::WrappingLeft",
      "l": "vim::WrappingRight"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "j j": "vim::NormalBefore"
    }
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-up": "vim::ResizePaneUp",
      "ctrl-down": "vim::ResizePaneDown",
      "ctrl-left": "vim::ResizePaneLeft",
      "ctrl-right": "vim::ResizePaneRight",
      "ctrl-d": [
        "workspace::SendKeystrokes",
        "ctrl-d z z"
      ],
      "ctrl-u": [
        "workspace::SendKeystrokes",
        "ctrl-u z z"
      ],
      "ctrl-/": "terminal_panel::Toggle",
      "ctrl-_": "terminal_panel::Toggle",
      "space ,": "tab_switcher::ToggleAll",
      "space b b": "tab_switcher::ToggleAll",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b d": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ],
      "space w": "workspace::Save",
      "space q q": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ],
      "space n": "editor::GoToDiagnostic",
      "space N": "editor::GoToPreviousDiagnostic",
      "K": "editor::Hover",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g I": "editor::GoToImplementation",
      "g R": "editor::FindAllReferences",
      "g y": "editor::GoToTypeDefinition",
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "space c f": "editor::Format",
      "space c s": "outline::Toggle",
      "space c d": "editor::Hover",
      "[ h": "editor::GoToPreviousHunk",
      "] h": "editor::GoToHunk",
      "space h p": "editor::GoToPreviousHunk",
      "space h n": "editor::GoToHunk",
      "space t t": "editor::SpawnNearestTask",
      "space d b": "editor::ToggleBreakpoint",
      "space d c": "debugger::Continue",
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOver",
      "space d O": "debugger::StepOut"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "J": "editor::MoveLineDown",
      "K": "editor::MoveLineUp",
      "shift-s": "vim::PushAddSurrounds"
    }
  }
]
